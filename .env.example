# 本地开发 / 生产运行共用的环境变量示例
# 复制成 .env 后按需修改；.env 不会被 git 跟踪。

# 监听地址：默认只监听回环，公网访问请用 Cloudflare Tunnel / 反向代理
HOST=127.0.0.1
PORT=8787

# 数据根目录：catalog.json 与 projects/ 都在这里，务必和代码目录分开
DATA_DIR=./data

# 前端构建产物目录；默认会自动探测 dist/web，通常不用设置
# WEB_DIST_DIR=./dist/web

# 站点对外地址（图片/下载/试玩的绝对 URL 用它拼），本地开发可以留空
# PUBLIC_BASE_URL=https://share.fennecmomo.top

# debug | info | warn | error
LOG_LEVEL=info

# 发布限额（可选，单位字节/个数），默认值见 docs/HERMES_PUBLISH_GUIDE.md
# FH_PUBLISH_MAX_DOWNLOAD_BYTES=4294967296
# FH_PUBLISH_MAX_IMAGE_BYTES=12582912
# FH_PUBLISH_MAX_ZIP_BYTES=2147483648
# FH_PUBLISH_MAX_FILES=20000
# FH_PUBLISH_MAX_UNCOMPRESSED_BYTES=4294967296
# FH_PUBLISH_MAX_ENTRY_BYTES=536870912
# FH_PUBLISH_EXTRA_EXTENSIONS=.rar,.tar.zst
