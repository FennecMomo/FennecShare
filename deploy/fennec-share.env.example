# Fennec Share 服务端环境变量（由 deploy.sh 生成，也可以手工维护）
# 这个文件只放配置，不放密钥：本项目没有需要保密的凭据。
# 修改后执行：sudo systemctl restart fennec-share

# 只监听回环，由 Cloudflare Tunnel（cloudflared）转发进来
HOST=127.0.0.1
PORT=8770

# 数据目录：catalog.json、projects/、staging/、backups/ 都在这里，和代码目录分离
DATA_DIR=/home/ubuntu/fennec-share-data

# 前端构建产物目录（npm run build 生成）
WEB_DIST_DIR=/home/ubuntu/dev-projects/fennec-share/dist/web

# 对外站点地址：用于发布结果里的绝对 URL，必须是最终用户看到的域名
PUBLIC_BASE_URL=https://share.fennecmomo.top

LOG_LEVEL=info
